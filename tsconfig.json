{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@prisma/client": ["./backend/node_modules/@prisma/client"],
      "*": ["./backend/node_modules/*", "./frontend/node_modules/*"]
    }
  },
  "references": [
    { "path": "./backend" }
  ],
  "exclude": [
    "node_modules",
    "backend/dist",
    "frontend/.next"
  ]
}
