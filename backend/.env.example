# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_random_64_char_string
JWT_EXPIRES_IN=7d

# ─── Session (Passport) ───────────────────────────────────────────────────────
SESSION_SECRET=change_me_to_another_random_string

# ─── Slack OAuth ──────────────────────────────────────────────────────────────
# Create at https://api.slack.com/apps
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:4000/slack/callback

# ─── Ethereal SMTP ────────────────────────────────────────────────────────────
# Leave blank to auto-generate a test account on first start (printed to console)
ETHEREAL_USER=
ETHEREAL_PASS=
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587

# ─── Email Scheduler Limits ───────────────────────────────────────────────────
MAX_EMAILS_PER_HOUR=50
MIN_DELAY_MS=2000
WORKER_CONCURRENCY=5
